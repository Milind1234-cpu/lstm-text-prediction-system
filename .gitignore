# ============================================================================
# Data Files
# ============================================================================
# Raw Wikipedia articles
data/raw/*.txt
data/raw/*.json

# Processed training data
data/processed/*.txt
data/processed/*.json
data/processed/*.npy
data/processed/*.npz

# Keep .gitkeep files
!data/raw/.gitkeep
!data/processed/.gitkeep

